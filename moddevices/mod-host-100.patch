From f04a2d929cae3a01f5e728901206e9a1d5b7fb68 Mon Sep 17 00:00:00 2001
From: Pau Aliagas <linuxnow@gmail.com>
Date: Thu, 3 Sep 2026 23:33:02 +0200
Subject: [PATCH 1/3] Fix worker_finish() joining a thread that was never
 started

worker_init() calls zix_thread_create() but never checks whether it actually
started a thread. When it fails, worker_finish() still calls
zix_thread_join(worker->thread, NULL) on an uninitialized pthread_t, which
segfaults inside glibc.

Reproduced with a debug build and gdb against
http://lsp-plug.in/plugins/lv2/para_equalizer_x16_stereo: zix_thread_create()
fails with pthread_create() returning EINVAL for this plugin's worker thread,
and worker_finish() (called from effects_remove/effects_finish on a graceful
`remove` or `quit`) then joins the zeroed handle and crashes.

Track whether the thread actually started and only join it if it did. Also
logs the actual pthread_create()/pthread_attr_setstacksize() failure by name
via strerror(), so a similar failure isn't silent next time.
---
 src/worker.c     | 14 ++++++++++++--
 src/worker.h     |  2 ++
 src/zix/thread.h | 11 ++++++++++-
 3 files changed, 24 insertions(+), 3 deletions(-)

diff --git a/src/worker.c b/src/worker.c
index 6159d6c0..5cdf3b10 100644
--- a/src/worker.c
+++ b/src/worker.c
@@ -61,7 +61,13 @@ void worker_init(worker_t *worker, LilvInstance *instance, const LV2_Worker_Inte
     worker->iface = iface;
     worker->instance = instance;
     sem_init(&worker->sem, 0, 0);
-    zix_thread_create(&worker->thread, size + sizeof(void*) * 4, worker_func, worker);
+    const ZixStatus thread_status =
+        zix_thread_create(&worker->thread, size + sizeof(void*) * 4, worker_func, worker);
+    worker->thread_started = (thread_status == ZIX_STATUS_SUCCESS);
+    if (!worker->thread_started) {
+        fprintf(stderr, "worker_init: zix_thread_create() failed (status %d) -- "
+                         "this plugin's LV2 worker extension will not run\n", (int)thread_status);
+    }
     worker->requests  = jack_ringbuffer_create(size);
     worker->responses = jack_ringbuffer_create(size);
     worker->response  = malloc(size);
@@ -72,9 +78,13 @@ void worker_init(worker_t *worker, LilvInstance *instance, const LV2_Worker_Inte
 void worker_finish(worker_t *worker)
 {
     worker->exit = true;
-    if (worker->requests) {
+    /* Only join a thread zix_thread_create() actually reported starting -- `requests` is
+       allocated unconditionally above and is not evidence of that (see worker_init()). */
+    if (worker->thread_started) {
         sem_post(&worker->sem);
         zix_thread_join(worker->thread, NULL);
+    }
+    if (worker->requests) {
         jack_ringbuffer_free(worker->requests);
         jack_ringbuffer_free(worker->responses);
         free(worker->response);
diff --git a/src/worker.h b/src/worker.h
index 65401fa5..de13fbb8 100644
--- a/src/worker.h
+++ b/src/worker.h
@@ -27,6 +27,8 @@ typedef struct WORKER_T {
     void *response;
     sem_t sem;
     ZixThread thread;
+    /* True only once zix_thread_create() reports success for `thread` above. */
+    bool thread_started;
     const LV2_Worker_Interface *iface;
     LilvInstance *instance;
     bool exit;
diff --git a/src/zix/thread.h b/src/zix/thread.h
index 2c5bd143..fe4db201 100644
--- a/src/zix/thread.h
+++ b/src/zix/thread.h
@@ -22,6 +22,8 @@
 #else
 #    include <errno.h>
 #    include <pthread.h>
+#    include <stdio.h>
+#    include <string.h>
 #endif
 
 #include "common.h"
@@ -94,9 +96,16 @@ zix_thread_create(ZixThread* thread,
 {
     pthread_attr_t attr;
     pthread_attr_init(&attr);
-    pthread_attr_setstacksize(&attr, stack_size);
+    const int ss_ret = pthread_attr_setstacksize(&attr, stack_size);
+    if (ss_ret) {
+        fprintf(stderr, "zix_thread_create: pthread_attr_setstacksize(%zu) failed: %s\n",
+                stack_size, strerror(ss_ret));
+    }
 
     const int ret = pthread_create(thread, &attr, function, arg);
+    if (ret) {
+        fprintf(stderr, "zix_thread_create: pthread_create() failed: %s\n", strerror(ret));
+    }
     pthread_attr_destroy(&attr);
 
     if (ret == EAGAIN) {

From cadb380c9a2b670e6402abbc181b232cd1afa930 Mon Sep 17 00:00:00 2001
From: Pau Aliagas <linuxnow@gmail.com>
Date: Thu, 3 Sep 2026 23:35:30 +0200
Subject: [PATCH 2/3] Fix NULL event buffer on an unsized atom input port

AllocatePortBuffers() skips allocating a buffer for any event port it's
handed a zero size for. effects_add() passes 0 for any atom input port
that declares neither an lv2:control designation nor rsz:minimumSize --
the output side already has a default (g_midi_buffer_size * 16), the
input side didn't. That port then reaches jack_activate() with a NULL
buffer and unconnected, and the process callback's
lv2_evbuf_reset(port->evbuf, true) dereferences it.

Intermittent: JACK's buffer-size callback calls AllocatePortBuffers()
again and does allocate the buffer, and nothing orders it against the
first process callback, so whether the crash fires depends on which
callback runs first.

Reproduced with a debug build and gdb against
http://gareus.org/oss/lv2/midifilter#tonalpedal (crashes at
src/lv2_evbuf.c:85). Hits a whole class of plugins, not just one: every
plugin with a bare MIDI/atom input port and no size hint, x42's
midifilter set (33 plugins) among them.
---
 src/effects.c | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/src/effects.c b/src/effects.c
index 7786bc81..0ad8b98d 100644
--- a/src/effects.c
+++ b/src/effects.c
@@ -971,9 +971,19 @@ static void AllocatePortBuffers(effect_t* effect, int in_size, int out_size)
 
     for (i = 0; i < effect->event_ports_count; i++)
     {
-        const int size = effect->event_ports[i]->flow == FLOW_INPUT ? in_size : out_size;
+        int size = effect->event_ports[i]->flow == FLOW_INPUT ? in_size : out_size;
+
+        /* A zero size means "leave this port's buffer as it already is" -- BufferSize() passes it
+           that way for ports whose size is pinned to something other than the default. Skipping
+           is only safe once the port HAS a buffer; a port that never got one needs the same
+           default the output side already has below. */
         if (size == 0)
-            continue;
+        {
+            if (effect->event_ports[i]->evbuf != NULL)
+                continue;
+            size = g_midi_buffer_size * 16; // 16 taken from jalv source code
+        }
+
         lv2_evbuf_free(effect->event_ports[i]->evbuf);
         effect->event_ports[i]->evbuf = lv2_evbuf_new(
             size,

From 447d88becb71b95823bd43214f1c8dcbcdb79b96 Mon Sep 17 00:00:00 2001
From: Pau Aliagas <linuxnow@gmail.com>
Date: Thu, 3 Sep 2026 23:36:00 +0200
Subject: [PATCH 3/3] Refuse a plugin lilv could not fully describe

Some plugin bundles' Turtle reuses one blank node as the lv2:port of
more than one plugin subject. lilv then reports fewer ports than the
plugin binary's own compiled LV2 descriptor actually has, so some of
what jack_activate() wires up is never lilv_instance_connect_port()-ed,
and the real-time thread calls into the plugin with an unconnected port.

Reproduced with liblilv 0.26.4 independent of mod-host, via the
standalone lv2info tool, against the ll-plugins.nongnu.org
math-constant/math-function set (51 catalog URIs). Whether the crash
manifests is racy (a JACK/PipeWire graph scheduling race against
`remove`); the underlying port-count mismatch is not.

effects_add() now refuses to activate any plugin whose classified port
count doesn't match what lilv reported, returning
ERR_LV2_INSTANTIATION instead of running an effect it knows it failed
to wire up.
---
 src/effects.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/src/effects.c b/src/effects.c
index 0ad8b98d..fc6a484b 100644
--- a/src/effects.c
+++ b/src/effects.c
@@ -5108,6 +5108,23 @@ int effects_add(const char *uri, int instance)
         }
     }
 
+    /* lilv can undercount a plugin's ports relative to what its compiled LV2 descriptor actually
+       has (some bundles' Turtle reuses one blank node as the lv2:port of more than one plugin
+       subject). When that happens, some of what jack_activate() below wires up is never
+       lilv_instance_connect_port()-ed, and the real-time thread calls into the plugin with an
+       unconnected port. Refuse rather than activate a plugin lilv could not fully describe. */
+    if (ports_count == 0 ||
+        (audio_ports_count + control_ports_count + cv_ports_count + event_ports_count) != ports_count)
+    {
+        fprintf(stderr, "effects_add: lilv reported %u port(s) for %s but only classified "
+                         "%u (audio) + %u (control) + %u (cv) + %u (event) -- refusing to "
+                         "activate an effect lilv could not fully describe\n",
+                ports_count, uri, audio_ports_count, control_ports_count, cv_ports_count,
+                event_ports_count);
+        error = ERR_LV2_INSTANTIATION;
+        goto error;
+    }
+
     // special ports
     {
         const LilvPort* enabled_port = lilv_plugin_get_port_by_designation(plugin, g_lilv_nodes.input, g_lilv_nodes.enabled);
