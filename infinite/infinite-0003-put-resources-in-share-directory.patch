From: Yann Collette <ycollette.nospam@free.fr>
Date: Sat, 26 Sep 2026 11:17:17 +0200
Subject: [PATCH] put resources in share directory

---
 src/main.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/main.cpp b/src/main.cpp
index ad45033..e4ee58e 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -47574,7 +47574,7 @@ namespace
       std::filesystem::path resourceDir = exeDir.parent_path() / "Resources";
 #else
       // No bundle on Windows/Linux: Resources sits next to Infinite binary.
-      std::filesystem::path resourceDir = exeDir / "Resources";
+      std::filesystem::path resourceDir = "/usr/share/infinite/";
 #endif
       std::filesystem::path full = resourceDir / relPath;
       std::error_code ec;
