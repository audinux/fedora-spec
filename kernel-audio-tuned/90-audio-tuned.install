#!/bin/bash

set -euo pipefail
shopt -s nullglob

COMMAND="${1:-}"
KERNEL_VERSION="${2:-}"

BOOT_DIR="/boot"
ENTRY_DIR="${BOOT_DIR}/loader/entries"

SYSCONFIG="/etc/sysconfig/kernel-audio-tuned"

# ----------------------------------------------------------------------
# Load user configuration
# ----------------------------------------------------------------------

if [[ -f "$SYSCONFIG" ]]; then
    source "$SYSCONFIG" || true
fi

: "${KERNEL_AUDIO_TUNED_ENABLE:=yes}"

if [[ "$KERNEL_AUDIO_TUNED_ENABLE" != "yes" ]]; then
    exit 0
fi

# ----------------------------------------------------------------------
# Read installonly_limit from dnf
# ----------------------------------------------------------------------

get_installonly_limit() {
    local limit

    limit=$(
        grep -E '^installonly_limit=' /etc/dnf/dnf.conf 2>/dev/null \
        | cut -d= -f2 \
        || true
    )

    if [[ -z "${limit:-}" ]]; then
        limit=3
    fi

    echo "$limit"
}

# ----------------------------------------------------------------------
# Suffixes this hook manages, for entry basename/title lookups. Every
# function below that needs to recognize or skip "already tuned" entries
# iterates this list instead of hardcoding "-audio".
# ----------------------------------------------------------------------

TUNED_SUFFIXES=(audio rt-tuned)

is_tuned_entry() {
    local base="$1"
    local suffix

    for suffix in "${TUNED_SUFFIXES[@]}"; do
        if [[ "$base" == *-"$suffix" ]]; then
            return 0
        fi
    done

    return 1
}

# ----------------------------------------------------------------------
# Creation of a tuned entry (audio or rt-tuned, per SUFFIX/TITLE/OPTS)
# ----------------------------------------------------------------------

create_entry() {
    local entry="$1"
    local suffix="$2"
    local title="$3"
    local opts="$4"

    local base
    base="$(basename "$entry" .conf)"

    # avoid tuning an already-tuned entry
    if is_tuned_entry "$base"; then
        return
    fi

    local new_entry="${ENTRY_DIR}/${base}-${suffix}.conf"

    # avoid doubles
    if [[ -f "$new_entry" ]]; then
        return
    fi

    cp "$entry" "$new_entry" || :

    # Change the title
    sed -i \
        "s|^title \(.*\)\$|title \1 (${title})|" \
        "$new_entry" || :

    # Add the kernel options
    sed -i \
        "s|^options \(.*\)\$|options \1 ${opts}|" \
        "$new_entry" || :
}

# ----------------------------------------------------------------------
# Removal of every tuned entry derived from a given boot entry
# ----------------------------------------------------------------------

remove_entry() {
    local entry="$1"

    local base
    base="$(basename "$entry" .conf)"

    # Avoid double computation
    if is_tuned_entry "$base"; then
        return
    fi

    local suffix
    for suffix in "${TUNED_SUFFIXES[@]}"; do
        rm -f "${ENTRY_DIR}/${base}-${suffix}.conf" || :
    done
}

# ----------------------------------------------------------------------
# Removal of old entries
# ----------------------------------------------------------------------

cleanup_entries() {
    local max
    max="$(get_installonly_limit)"

    local suffix
    for suffix in "${TUNED_SUFFIXES[@]}"; do
        mapfile -t entries < <(
            printf '%s\n' "${ENTRY_DIR}"/*-"${suffix}".conf \
            | sort -V
        )

        local count="${#entries[@]}"

        if (( count > max )); then
            for ((i=0; i < count - max; i++)); do
                rm -f "${entries[$i]}" || :
            done
        fi
    done
}

# ----------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------

case "$COMMAND" in
    add)
        CPU_VENDOR="$(grep -m1 'vendor_id' /proc/cpuinfo 2>/dev/null | awk '{print $3}' || true)"
        CPU_OPTS=""
        case "$CPU_VENDOR" in
            GenuineIntel) CPU_OPTS="${KERNEL_AUDIO_TUNED_INTEL_OPTS:-}" ;;
            AuthenticAMD) CPU_OPTS="${KERNEL_AUDIO_TUNED_AMD_OPTS:-}" ;;
        esac

        entries=( "${ENTRY_DIR}"/*"${KERNEL_VERSION}"*.conf )

        # kernel-rt-mao (version contains ".rt") gets its own "-rt-tuned"
        # entries instead of the standard "-audio" ones: same threadirqs/
        # nopti/CPU tuning, but without preempt=full since the RT kernel
        # is already built fully preemptible.
        if [[ "$KERNEL_VERSION" == *".rt"* ]]; then
            : "${KERNEL_AUDIO_TUNED_RT_ENABLE:=yes}"
            if [[ "$KERNEL_AUDIO_TUNED_RT_ENABLE" != "yes" ]]; then
                exit 0
            fi

            FINAL_OPTS="${KERNEL_AUDIO_TUNED_RT_OPTS:-} ${CPU_OPTS}"

            for entry in "${entries[@]}"; do
                create_entry "$entry" "rt-tuned" "RT tuned" "$FINAL_OPTS"
            done

            cleanup_entries
            exit 0
        fi

        # Skip non-standard kernel flavors (LQX, Xanmod, …)
        for skip in ${KERNEL_AUDIO_TUNED_SKIP_FLAVORS:-}; do
            if [[ "$KERNEL_VERSION" == *"$skip"* ]]; then
                exit 0
            fi
        done

        FINAL_OPTS="${KERNEL_AUDIO_TUNED_OPTS:-} ${CPU_OPTS}"

        for entry in "${entries[@]}"; do
            create_entry "$entry" "audio" "Audio tuned" "$FINAL_OPTS"
        done

        cleanup_entries
        ;;

    remove)
        entries=( "${ENTRY_DIR}"/*"${KERNEL_VERSION}"*.conf )

        for entry in "${entries[@]}"; do
            remove_entry "$entry"
        done
        ;;
esac

exit 0
