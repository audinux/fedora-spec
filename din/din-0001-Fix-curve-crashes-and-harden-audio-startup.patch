diff --git a/tests/curve-regressions.cc b/tests/curve-regressions.cc
new file mode 100644
index 0000000..8e0a92f
--- /dev/null
+++ b/tests/curve-regressions.cc
@@ -0,0 +1,164 @@
+#include "multi_curve.h"
+
+#include <cassert>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+
+std::list<crvpt> curve::LIST_OF_POINTS;
+std::string user_data_dir;
+std::ofstream dlog ("/dev/null");
+extern const char spc = ' ';
+
+// The application supplies this UI helper; these tests never rename curves.
+void make_good_name (std::string&) {
+  throw std::logic_error ("unexpected name helper call");
+}
+
+void add_point (multi_curve& c, float x, float y) {
+  c.add_vertex (x, y);
+  c.add_left_tangent (x, y);
+  c.add_right_tangent (x, y);
+}
+
+void check_counts (const multi_curve& c, int vertices) {
+  assert (c.num_vertices == vertices);
+  assert (c.last_vertex == vertices - 1);
+  assert (c.vertices.size () == static_cast<unsigned int> (vertices));
+  assert (c.left_tangents.size () == c.vertices.size ());
+  assert (c.right_tangents.size () == c.vertices.size ());
+  assert (c.ncurvs == (vertices ? vertices - 1 : 0));
+  assert (c.curv.size () == static_cast<unsigned int> (c.ncurvs));
+}
+
+void clear_curve () {
+  multi_curve c;
+  add_point (c, 0, 0);
+  add_point (c, 1, 1);
+  c.evaluate ();
+  c.clear ();
+  check_counts (c, 0);
+  c.evaluate ();
+  add_point (c, 0, 0);
+  c.set_vertex (0, 1, 1);
+  check_counts (c, 1);
+}
+
+void endpoint_tangent () {
+  multi_curve c;
+  add_point (c, 0, 0);
+  add_point (c, 1, 1);
+  c.evaluate ();
+  assert (c.set_right_tangent (1, 2, 3));
+  assert (c.right_tangents[1].x == 2);
+  assert (c.right_tangents[1].y == 3);
+  c.evaluate ();
+  assert (!c.curv[0].eval);
+}
+
+void catmull_rom () {
+  multi_curve c;
+  for (int i = 0; i < 5; ++i) add_point (c, i, i % 2);
+  convert2_catmull_rom (c, 0.25f);
+  for (int i = 1; i < c.last_vertex; ++i) {
+    assert (c.left_tangents[i].x == i - 0.5f);
+    assert (c.right_tangents[i].x == i + 0.5f);
+    assert (c.left_tangents[i].y == c.vertices[i].y);
+    assert (c.right_tangents[i].y == c.vertices[i].y);
+  }
+  check_counts (c, 5);
+}
+
+void remove_vertices () {
+  for (int endpoint = 0; endpoint < 2; ++endpoint) {
+    multi_curve c;
+    add_point (c, 0, 0);
+    add_point (c, 1, 1);
+    c.evaluate ();
+    assert (!c.remove (endpoint));
+    assert (c.remove (endpoint, 0));
+    check_counts (c, 1);
+    c.evaluate ();
+    assert (c.remove (0, 0));
+    check_counts (c, 0);
+  }
+}
+
+void empty_profile () {
+  multi_curve c;
+  // Establish a known count even on the old implementation.
+  add_point (c, 0, 0);
+  add_point (c, 1, 1);
+  c.remove (1, 0);
+  std::vector<int> counts (3, 42);
+  std::vector<crvpt> profile (3);
+  assert (c.get_total_points () == 0);
+  assert (c.get_total_points (counts) == 0);
+  assert (counts.empty ());
+  assert (c.get_profile_points (profile) == 0);
+  assert (profile.empty ());
+}
+
+void normal_profile () {
+  multi_curve c;
+  add_point (c, 0, 0);
+  add_point (c, 1, 1);
+  add_point (c, 2, 0);
+  c.evaluate ();
+  std::vector<int> counts;
+  std::vector<crvpt> profile;
+  const int total = c.get_total_points ();
+  assert (c.get_total_points (counts) == total);
+  assert (c.get_profile_points (profile) == total);
+  assert (profile.size () == static_cast<unsigned int> (total));
+  assert (profile.front ().x == 0);
+  assert (profile.back ().x == 2);
+  assert (counts[0] + counts[1] == total);
+  convert2_polyline (c, 0);
+  assert (c.get_total_points () == 3);
+}
+
+void rebuild_curve () {
+  multi_curve c;
+  for (int i = 0; i < 5; ++i) add_point (c, i, i % 2);
+  c.evaluate ();
+  assert (c.remove (2));
+  check_counts (c, 4);
+  c.evaluate ();
+  assert (c.insert (2, 1) == 2);
+  check_counts (c, 5);
+  c.evaluate ();
+  std::vector<crvpt> profile;
+  assert (c.get_profile_points (profile) > 0);
+  c.dropfrom (0, 3);
+  check_counts (c, 2);
+  c.evaluate ();
+  convert2_polyline (c, 0);
+  assert (c.get_total_points () == 2);
+}
+
+struct test_case {
+  const char* name;
+  void (*run) ();
+};
+
+int main (int argc, char** argv) {
+  const test_case tests[] = {
+    {"clear", clear_curve},
+    {"endpoint", endpoint_tangent},
+    {"catmull", catmull_rom},
+    {"remove", remove_vertices},
+    {"empty", empty_profile},
+    {"normal", normal_profile},
+    {"rebuild", rebuild_curve}
+  };
+  bool found = false;
+  for (unsigned int i = 0; i < sizeof (tests) / sizeof (tests[0]); ++i) {
+    if (argc == 1 || tests[i].name == std::string (argv[1])) {
+      tests[i].run ();
+      std::cout << "PASS " << tests[i].name << std::endl;
+      found = true;
+    }
+  }
+  return found ? 0 : 1;
+}
diff --git a/tests/tcl-regressions.cc b/tests/tcl-regressions.cc
new file mode 100644
index 0000000..2d7c497
--- /dev/null
+++ b/tests/tcl-regressions.cc
@@ -0,0 +1,55 @@
+#include "command.h"
+#include "tcl_interp.h"
+#include "tokenizer.h"
+
+#include <cassert>
+#include <fstream>
+#include <iostream>
+#include <string>
+
+cmdlist cmdlst;
+cmdlist::~cmdlist () {}
+std::ofstream dlog ("/dev/null");
+extern const char spc = ' ';
+char tokenizer::delim = spc;
+char BUFFER[65536];
+double MIDI_BPM = 0, TAP_BPM = 0, TIME_NOW = 0;
+float VOLUME = 0;
+
+void add_commands (Tcl_Interp*) {}
+
+struct echo_command : command {
+  echo_command () : command ("din_test", "dt") {}
+
+  int operator() (tokenizer& tz) {
+    std::string arg;
+    tz >> arg;
+    cmdlst.result = arg;
+    tz >> arg;
+    if (!arg.empty ()) cmdlst.result += "|" + arg;
+    return 1;
+  }
+};
+
+int main () {
+  Tcl_Interp* interp = Tcl_CreateInterp ();
+  assert (interp);
+  echo_command echo;
+  cmdlst.cmds[0] = &echo;
+  Tcl_CreateObjCommand (interp, "din_test", tcl_run, 0, 0);
+
+  assert (Tcl_Eval (interp, "din_test {first argument} second") == TCL_OK);
+  assert (std::string (Tcl_GetStringResult (interp)) == "first argument|second");
+  assert (Tcl_Eval (interp, "din_test") == TCL_OK);
+  assert (std::string (Tcl_GetStringResult (interp)) == "din_test");
+
+  std::string expected (4096, 'x');
+  std::string script = "din_test " + expected;
+  assert (Tcl_Eval (interp, script.c_str ()) == TCL_OK);
+  cmdlst.result.assign (16384, 'y');
+  assert (std::string (Tcl_GetStringResult (interp)) == expected);
+
+  Tcl_DeleteInterp (interp);
+  Tcl_Finalize ();
+  std::cout << "PASS Tcl arguments and result ownership" << std::endl;
+}
