+        AC_MSG_RESULT([no])
+        m4_default([$4], [AC_MSG_FAILURE(
+[A pkg-config implementation could not be found or is too old.  Make sure it
+is in your PATH or set the PKG_CONFIG environment variable to the full
+path to pkg-config.
+
